# =============================================================================
# Postgres (consumed by the `postgres` service in docker-compose)
# =============================================================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nodeforge

# =============================================================================
# Backend (FastAPI)
# =============================================================================
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/nodeforge
JWT_SECRET=change-me-32-bytes-min-please-rotate-in-prod
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=7
EXECUTOR_URL=http://executor:8001
EXECUTOR_TIMEOUT_SECONDS=30
CORS_ORIGINS=http://localhost:3000

# `Secure` flag for the auth cookie. Production must be true. Browsers grant
# a localhost exception so true also works for browser dev, but curl over
# plain HTTP refuses to send Secure cookies — flip to false locally if you
# are exercising the auth endpoints with curl/cookies.txt.
COOKIE_SECURE=true

# Shared secret between Next.js server-side proxy and FastAPI backend.
# Defense-in-depth: lets the backend distinguish requests coming from the
# Next proxy (trusted) from direct external hits.
INTERNAL_API_TOKEN=change-me-rotate-in-prod

# Outbound email (password reset). `stdout` prints the link to the log
# instead of sending — dev default; no API key needed. Flip to `resend`
# in production and fill RESEND_API_KEY. EMAIL_FROM defaults to Resend's
# `onboarding@resend.dev` sender, which works without a verified domain
# (handy until DNS is wired). APP_BASE_URL is used to build absolute
# links inside the email body.
EMAIL_BACKEND=stdout
EMAIL_FROM=Node-Forge <onboarding@resend.dev>
RESEND_API_KEY=
APP_BASE_URL=http://localhost:3000

# =============================================================================
# Frontend (Next.js)
# -----------------------------------------------------------------------------
# Decision: the browser talks ONLY to Next on :3000. Next reverse-proxies
# internally (via app/api/...) to the backend, keeping the httpOnly cookie
# first-party. `BACKEND_INTERNAL_URL` is used server-side by the proxy.
# =============================================================================
BACKEND_INTERNAL_URL=http://backend:8000
# Placeholder for direct host hits (e.g. curl); the UI does not use it.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Disable Next.js anonymous telemetry. Also stops Next from creating a
# `cache/config.json` in the project root inside the container.
NEXT_TELEMETRY_DISABLED=1

# Sandbox runtime for ephemeral runner containers. `runc` is the default
# (fast, shared kernel). `runsc` routes through gVisor for strong syscall
# isolation — install per https://gvisor.dev/docs/user_guide/install/ and
# register in /etc/docker/daemon.json under `runtimes`.
RUNNER_RUNTIME=runc

# Max runner containers alive at once (each takes up to RUNNER_MEM_LIMIT
# and RUNNER_CPUS). Size it to the host. A run that finds every slot busy
# waits up to RUN_SLOT_WAIT_SECONDS, then fails with "Executor is busy".
MAX_CONCURRENT_RUNS=2
RUN_SLOT_WAIT_SECONDS=5
